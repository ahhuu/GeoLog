<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setting_root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_hud"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/setting_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp" />

        <!-- Card 1: Data Streaming -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GNSS Data Callbacks"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/register_location_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/register_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- Measurements -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/register_measurement_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/register_measurements"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Measurements"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- Navigation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/register_navigation_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/register_navigation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Navigation Message"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/register_status_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/register_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GnssStatus"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: RINEX & NMEA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logging &amp; Analysis"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <!-- RINEX -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/register_rinex_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/register_rinex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RINEX"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- NMEA (Moved Here) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/register_nmea_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/register_nmea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NMEA"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- Residual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/turn_on_residual_plot"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/residual_plot_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Residual Plot"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Screen & System -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Settings"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <!-- Auto Scroll (Moved Here) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/turn_on_auto_scroll"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/auto_scroll_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Scroll"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- Keep Screen On -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/keep_screen_on_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/keep_screen_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep Screen On"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

                <!-- Auto Dim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/auto_dim_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Switch is OFF"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/auto_dim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Dim (Logging)"
                        android:textColor="@color/on_surface_hud"
                        android:textStyle="bold"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/help"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="HELP"
                app:icon="@android:drawable/ic_menu_help" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="EXIT"
                android:textColor="@color/status_poor"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@color/status_poor" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>
