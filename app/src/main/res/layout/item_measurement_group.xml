<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GPS L1 C/A"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="monospace" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surface_hud"
        app:cardElevation="0dp"
        app:cardCornerRadius="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/stroke_hud">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/header_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATE [CLICK TO EXPAND]"
                android:textColor="@color/on_surface_hud"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.7"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/content_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_hud"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="8dp"
                android:visibility="gone"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginVertical="4dp"/>

            <TextView
                android:id="@+id/text_hw_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_hud"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="4dp"
                android:text="HW Clock Discontinuity: 0"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginVertical="4dp"/>

            <TextView
                android:id="@+id/header_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUALITY [CLICK TO EXPAND]"
                android:textColor="@color/on_surface_hud"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.7"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/content_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_hud"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="8dp"
                android:visibility="gone"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginVertical="4dp"/>

            <TextView
                android:id="@+id/header_uncertainty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UNCERTAINTY [CLICK TO EXPAND]"
                android:textColor="@color/on_surface_hud"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.7"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/content_uncertainty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_hud"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

