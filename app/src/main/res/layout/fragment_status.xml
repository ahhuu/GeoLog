<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_hud"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section 1: Quality Stats -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUALITY"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/container_quality_indicators"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Avg C/N0 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG C/N0"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/container_avg_cn0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: Satellite System Status - Full Width -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SATELLITE STATE"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TableLayout
                    android:id="@+id/table_sys_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0">

                    <TableRow android:background="@android:color/white" android:padding="4dp">
                        <TextView android:text="System Band" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Tot" android:textColor="@color/primary" android:paddingStart="8dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Use" android:textColor="@color/status_good" android:paddingStart="8dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Unu" android:textColor="@color/status_poor" android:paddingStart="8dp" android:textSize="12sp" android:textStyle="bold"/>
                    </TableRow>
                    <!-- Rows will be added programmatically -->
                </TableLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 4: Device Info - Bento Box Grid -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_hud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView android:id="@+id/text_time_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_surface_hud" android:fontFamily="monospace" android:textSize="13sp" android:paddingVertical="2dp"/>
                <TextView android:id="@+id/text_hardware" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_surface_hud" android:fontFamily="monospace" android:textSize="13sp" android:paddingVertical="2dp"/>
                <TextView android:id="@+id/text_hw_year" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_surface_hud" android:fontFamily="monospace" android:textSize="13sp" android:paddingVertical="2dp"/>
                <TextView android:id="@+id/text_platform_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_surface_hud" android:fontFamily="monospace" android:textSize="13sp" android:paddingVertical="2dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>

